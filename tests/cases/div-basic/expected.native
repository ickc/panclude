Pandoc
  Meta { unMeta = fromList [] }
  [ Para
      [ Str "The"
      , Space
      , Str "file\8217s"
      , Space
      , Str "blocks"
      , Space
      , Str "go"
      , Space
      , Str "after"
      , Space
      , Str "the"
      , Space
      , Str "div\8217s"
      , Space
      , Str "own;"
      , Space
      , Str "the"
      , Space
      , Str "div"
      , Space
      , Str "keeps"
      , Space
      , Str "its"
      , Space
      , Str "identifier,"
      , SoftBreak
      , Str "classes"
      , Space
      , Str "and"
      , Space
      , Str "other"
      , Space
      , Str "attributes,"
      , Space
      , Str "but"
      , Space
      , Str "not"
      , Space
      , Code ( "" , [] , [] ) "include"
      , Str ","
      , Space
      , Code ( "" , [] , [] ) "format"
      , Space
      , Str "and"
      , SoftBreak
      , Code ( "" , [] , [] ) "shift-heading-level-by"
      , Str "."
      ]
  , Div
      ( "intro" , [ "chapter" ] , [ ( "lang" , "en" ) ] )
      [ Para
          [ Str "The"
          , Space
          , Str "div\8217s"
          , Space
          , Str "own"
          , Space
          , Str "paragraph,"
          , Space
          , Str "before"
          , Space
          , Str "the"
          , Space
          , Str "file\8217s"
          , Space
          , Str "blocks."
          ]
      , Header
          1 ( "introduction" , [] , [] ) [ Str "Introduction" ]
      , Para
          [ Str "A"
          , Space
          , Str "paragraph"
          , Space
          , Str "with"
          , Space
          , Emph [ Str "emphasis" ]
          , Str "."
          ]
      , BulletList
          [ [ Plain [ Str "a" , Space , Str "list" ] ]
          , [ Plain [ Str "of" , Space , Str "two" ] ]
          ]
      , CodeBlock ( "" , [ "python" ] , [] ) "print(\"code\")"
      ]
  , Para
      [ Str "An"
      , Space
      , Str "empty"
      , Space
      , Str "div"
      , Space
      , Str "is"
      , Space
      , Str "filled"
      , Space
      , Str "too."
      ]
  , Div
      ( "" , [] , [] )
      [ Header
          1 ( "introduction" , [] , [] ) [ Str "Introduction" ]
      , Para
          [ Str "A"
          , Space
          , Str "paragraph"
          , Space
          , Str "with"
          , Space
          , Emph [ Str "emphasis" ]
          , Str "."
          ]
      , BulletList
          [ [ Plain [ Str "a" , Space , Str "list" ] ]
          , [ Plain [ Str "of" , Space , Str "two" ] ]
          ]
      , CodeBlock ( "" , [ "python" ] , [] ) "print(\"code\")"
      ]
  ]
