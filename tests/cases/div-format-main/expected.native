Pandoc
  Meta { unMeta = fromList [] }
  [ Para
      [ Str "The"
      , Space
      , Str "main"
      , Space
      , Str "document"
      , Space
      , Str "is"
      , Space
      , Str "read"
      , Space
      , Str "with"
      , Space
      , Code ( "" , [] , [] ) "-f markdown-smart"
      , Str ":"
      , Space
      , Str "so"
      , Space
      , Str "are"
      , Space
      , Str "these,"
      , Space
      , Str "without"
      , SoftBreak
      , Code ( "" , [] , [] ) "format"
      , Str "."
      ]
  , Div
      ( "" , [] , [] )
      [ Para
          [ Str "He"
          , Space
          , Str "said"
          , Space
          , Str "\"hello\""
          , Space
          , Str "--"
          , Space
          , Str "twice."
          ]
      ]
  , Div
      ( "" , [] , [] )
      [ Para
          [ Str "He"
          , Space
          , Str "said"
          , Space
          , Str "\"hello\""
          , Space
          , Str "--"
          , Space
          , Str "twice."
          ]
      ]
  , Para
      [ Str "With"
      , Space
      , Code ( "" , [] , [] ) "format"
      , Str ","
      , Space
      , Str "pandoc's"
      , Space
      , Str "defaults"
      , Space
      , Str "for"
      , Space
      , Str "it."
      ]
  , Div
      ( "" , [] , [] )
      [ Para
          [ Str "He"
          , Space
          , Str "said"
          , Space
          , Quoted DoubleQuote [ Str "hello" ]
          , Space
          , Str "\8211"
          , Space
          , Str "twice."
          ]
      ]
  ]
