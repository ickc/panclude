          , Space
          , Str "from"
          , Space
          , Str "the"
          , Space
          , Str "main"
          , Space
          , Str "document\8217s"
          , SoftBreak
          , Str "directory:"
          , SoftBreak
          , Image ( "" , [] , [] ) [] ( "chapter/img.png" , "" )
          , SoftBreak
          , Image ( "" , [] , [] ) [] ( "chapter/img.png" , "" )
          , SoftBreak
          , Image ( "" , [] , [] ) [] ( "chapter/../top.png" , "" )
          , SoftBreak
          , Image ( "" , [] , [] ) [] ( "chapter/sub/deep.png" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "a" , Space , Str "link" ]
              ( "chapter/other.md#section" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "a"
              , Space
              , Str "link"
              , Space
              , Str "with"
              , Space
              , Str "a"
              , Space
              , Str "title"
              ]
              ( "chapter/other.md" , "the title" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "a" , Space , Str "bare" , Space , Str "word" ]
              ( "chapter/page" , "" )
          ]
      , Para
          [ Str "Not"
          , Space
          , Str "relative,"
          , Space
          , Str "and"
          , Space
          , Str "left"
          , Space
          , Str "alone:"
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "a" , Space , Str "URL" ]
              ( "https://example.org/x" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "mail" ]
              ( "mailto:a@example.org" , "" )
          , SoftBreak
          , Image
              ( "" , [] , [] )
              [ Str "data" ]
              ( "data:image/png;base64,AAAA" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "absolute" ]
              ( "/abs/path.md" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "network" , Space , Str "path" ]
              ( "//example.org/x" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "a" , Space , Str "Windows" , Space , Str "drive" ]
              ( "C:/x.md" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "a" , Space , Str "fragment" ]
              ( "#section" , "" )
          , SoftBreak
          , Link
              ( "" , [] , [] )
              [ Str "a" , Space , Str "query" ]
              ( "?q=1" , "" )
          , SoftBreak
          , Link ( "" , [] , [] ) [ Str "empty" ] ( "" , "" )
          ]
