      , Space
      , Str "targets"
      , Space
      , Str "are"
      , Space
      , Str "not"
      , Space
      , Str "rewritten:"
      , Space
      , Image ( "" , [] , [] ) [] ( "img.png" , "" )
      ]
  , Div
      ( "" , [] , [] )
      [ Para
          [ Str "Relative"
